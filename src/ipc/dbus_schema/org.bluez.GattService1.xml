<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface
    name="org.bluez.GattService1">

    <!-- 
      @brief 128-bit service UUID.
    -->
    <property name="UUID" type="s" access="read"></property>

    <!-- 
      @brief Indicates whether or not this GATT service is a primary service. If false, the service is
    secondary.
    -->
    <property
      name="Primary" type="b" access="read"></property>

    <!-- 
        @brief Object path of the Bluetooth device the service belongs to. Only present on services from
    remote devices.
    -->
    <!-- OPTIONAL <property name="Device" type="o" access="read"></property> -->

    <!-- 
      @brief Array of object paths representing the included services of this service.
    -->
    <!-- OPTIONAL <property name="Includes" type="ao" access="read"></property> -->

    <!-- 
      @brief Service handle. When available in the server it would attempt to use to allocate into the
    database which may fail, to auto allocate the value 0x0000 shall be used which will cause the
    allocated handle to be set once registered. -->
    <property name="Handle" type="q" access="readwrite"></property>
  </interface>
</node>