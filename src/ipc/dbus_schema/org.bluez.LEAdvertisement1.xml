<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface
    name="org.bluez.LEAdvertisement1">

    <!--
      @brief This method gets called when the bluetoothd(8) removes the Advertisement. A client can use
    it to do cleanup tasks. There is no need to call UnregisterAdvertisement() because when this
    method gets called it has already been unregistered.
    -->
    <method name="Release"></method>

    <!--
      @brief Determines the type of advertising packet requested.
      Possible values:
        "broadcast":	
        "peripheral":	
    -->
    <property name="Type" type="s" access="read"></property>

    <!--
      @brief List of UUIDs to include in the "Service UUID" field of the Advertising Data.	
    -->
    <!-- OPTIONAL <property name="ServiceUUIDs" type="as" access="read"></property> -->

    <!--
      @brief Manufacturer Data fields to include in the Advertising Data. Keys are the Manufacturer ID to
    associate with the data.	
    -->
    <property name="ManufacturerData" type="a{qv}" access="read"></property>

    <!--
      @brief List of UUIDs to include in the "Service Solicitation" field of the Advertising Data.
    -->
    <!-- OPTIONAL <property name="SolicitUUIDs" type="as" access="read"></property> -->

    <!--
      @brief Service Data elements to include in the Advertising Data. The keys are the UUID to associate
    with the data.
    -->
    <!-- OPTIONAL <property name="ServiceData" type="a{sv}" access="read"></property> -->

    <!--
      @brief Key is the advertising type and value is the data as byte array.
            Note: Types already handled by other properties shall not be used.
            Possible values:
            <type>:	<byte array>
              Example:
              <Transport Discovery> <Organization Flags...> 0x26 0x01 0x01...
    -->
    <!-- OPTIONAL <property name="Data" type="a{yv}" access="read"></property> -->

    <!--
      @brief List of UUIDs to include in the "Service UUID" field of the Scan Response Data.
    -->
    <!-- OPTIONAL <property name="ScanResponseServiceUUIDs" type="as" access="read"></property> -->

    <!--
      @brief Manufacturer Data fields to include in the Scan Response Data. Keys are the Manufacturer ID
    to associate with the data.
    -->
    <!-- OPTIONAL <property name="ScanResponseManufacturerData" type="a{qv}"
    access="read"></property> -->

    <!--
      @brief List of UUIDs to include in the "Service Solicitation" field of the Scan Response Data.
    -->
    <!-- OPTIONAL <property name="ScanResponseSolicitUUIDs" type="as" access="read"></property> -->

    <!--
      @brief Service Data elements to include in the Scan Response Data. The keys are the UUID to
    associate with the data.
    -->
    <!-- OPTIONAL <property name="ScanResponseServiceData" type="a{sv}" access="read"></property> -->

    <!--
      @brief Scan Response Data to include. Key is the advertising type and value is the data as byte
    array.
    -->
    <!-- OPTIONAL <property name="ScanResponseData" type="a{yv}" access="read"></property> -->

    <!--
      @brief Advertise as general discoverable. When present this will override adapter Discoverable
    property. Note: This property shall not be set when Type is set to "broadcast".
    -->
    <!-- OPTIONAL <property name="Discoverable" type="b" access="read"></property> -->

    <!--
      @brief The discoverable timeout in seconds. A value of zero means that the timeout is disabled and
    it will stay in discoverable/limited mode forever. 
      Note: This property shall not be set when Type is set to "broadcast".
    -->
    <!-- OPTIONAL <property name="DiscoverableTimeout" type="q" access="read"></property> -->

    <!--
      @brief List of features to be included in the advertising packet.
      Possible values:
      See org.bluez.LEAdvertisingManager(5) SupportedIncludes property.
    -->
    <!-- OPTIONAL <property name="Includes" type="as" access="read"></property> -->

    <!--
      @brief Local name to be used in the advertising report. If the string is too big to fit into the
        packet it will be truncated.
        If this property is available 'local-name' cannot be present in the Includes.
    -->
    <property name="LocalName" type="s" access="read"></property>

    <!--
      @brief Appearance to be used in the advertising report.
      Possible values: as found on GAP Service.
    -->
    <!-- OPTIONAL <property name="Appearance" type="q" access="read"></property> -->

    <!--
      @brief Rotation duration of the advertisement in seconds. If there are other applications
    advertising no duration is set the default is 2 seconds.
    -->
    <property name="Duration" type="q" access="read"></property>

    <!--
      @brief Timeout of the advertisement in seconds. This defines the lifetime of the advertisement.
    -->
    <property name="Timeout" type="q" access="read"></property>

    <!--
      @brief Secondary channel to be used. Primary channel is always set to "1M" except when "Coded" is
    set.
      Possible value:
      "1M" (default):	
      "2M":	
      "Coded":	
    -->
    <!-- OPTIONAL <property name="SecondaryChannel" type="s" access="read"></property> -->

    <!--
      @brief Minimum advertising interval to be used by the advertising set, in milliseconds. Acceptable
        values are in the range [20ms, 10,485s].
      If the provided MinInterval is larger than the provided MaxInterval, the registration will return
        failure.
    -->
    <property name="MinInterval" type="u" access="read"></property>

    <!--
      @brief Maximum advertising interval to be used by the advertising set, in milliseconds.
        Acceptable values are in the range [20ms, 10,485s].
        If the provided MinInterval is larger than the provided MaxInterval, the registration will return
            failure.
    -->
    <property name="MaxInterval" type="u" access="read"></property>

    <!--
      @brief Requested transmission power of this advertising set.
      The provided value is used only if the "CanSetTxPower" feature is enabled on the
          org.bluez.LEAdvertisingManager(5).
      Values must be in range [-127 to +20], where units are in dBm.
    -->
    <!-- OPTIONAL <property name="TxPower" type="n" access="read"></property> -->

    <!--
      @brief Instance of the advertisement. Set by bluetoothd after advertisement is registered with
    org.bluez.LEAdvertisingManager(5).
    -->
    <!-- OPTIONAL <property name="Instance" type="y" access="readwrite"></property> -->
  </interface>
</node>